<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr6_r700_gazebo">

  <!-- Include the raw clean URDF (primitive cylinders/boxes) -->
  <xacro:include filename="$(find kuka_kr6_gazebo)/urdf/kr6_r700_2_clean.urdf" />

  <!-- ================================================================
       ROS2 Control Hardware Interface (replaces gazebo_ros_control +
       transmission_interface from ROS1 — see deprecated/ros1_build/)
       ================================================================ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.9671</param>  <!-- -170 deg -->
        <param name="max">2.9671</param>   <!--  170 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-3.3161</param>  <!-- -190 deg -->
        <param name="max">0.7854</param>   <!--   45 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.0944</param>  <!-- -120 deg -->
        <param name="max">2.7227</param>   <!--  156 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.2289</param>  <!-- -185 deg -->
        <param name="max">3.2289</param>   <!--  185 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.0944</param>  <!-- -120 deg -->
        <param name="max">2.0944</param>   <!--  120 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-6.1087</param>  <!-- -350 deg -->
        <param name="max">6.1087</param>   <!--  350 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gazebo_ros2_control plugin (replaces libgazebo_ros_control.so from ROS1) -->
  <!-- ros2_controllers_yaml arg is passed as absolute path from the launch file -->
  <xacro:arg name="ros2_controllers_yaml" default=""/>
  <gazebo>
    <plugin name="controller_manager" filename="libgazebo_ros2_control.so">
      <parameters>$(arg ros2_controllers_yaml)</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- Physics materials -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="link_1">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="link_2">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="link_3">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="link_4">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="link_5">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="link_6">
    <material>Gazebo/Grey</material>
  </gazebo>

</robot>
