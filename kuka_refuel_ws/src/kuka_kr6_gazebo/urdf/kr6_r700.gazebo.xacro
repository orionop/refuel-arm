<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr6_r700_gazebo">

  <!-- Include the raw clean URDF (primitive cylinders/boxes) -->
  <xacro:include filename="$(find kuka_kr6_gazebo)/urdf/kr6_r700_2_clean.urdf" />

  <!-- ================================================================
       ROS2 Control Hardware Interface (replaces gazebo_ros_control +
       transmission_interface from ROS1 — see deprecated/ros1_build/)
       ================================================================ -->
  <ros2_control name="GzSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">100.0</param>
      <param name="position_derivative_gain">10.0</param>
      <command_interface name="position">
        <param name="min">-2.9671</param>  <!-- -170 deg -->
        <param name="max">2.9671</param>   <!--  170 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">100.0</param>
      <param name="position_derivative_gain">10.0</param>
      <command_interface name="position">
        <param name="min">-3.3161</param>  <!-- -190 deg -->
        <param name="max">0.7854</param>   <!--   45 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">100.0</param>
      <param name="position_derivative_gain">10.0</param>
      <command_interface name="position">
        <param name="min">-2.0944</param>  <!-- -120 deg -->
        <param name="max">2.7227</param>   <!--  156 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">50.0</param>
      <param name="position_derivative_gain">5.0</param>
      <command_interface name="position">
        <param name="min">-3.2289</param>  <!-- -185 deg -->
        <param name="max">3.2289</param>   <!--  185 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_5">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">50.0</param>
      <param name="position_derivative_gain">5.0</param>
      <command_interface name="position">
        <param name="min">-2.0944</param>  <!-- -120 deg -->
        <param name="max">2.0944</param>   <!--  120 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_6">
      <param name="initial_value">0.0</param>
      <param name="position_proportional_gain">50.0</param>
      <param name="position_derivative_gain">5.0</param>
      <command_interface name="position">
        <param name="min">-6.1087</param>  <!-- -350 deg -->
        <param name="max">6.1087</param>   <!--  350 deg -->
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gz_ros2_control plugin for Gz Sim (Gazebo Harmonic) -->
  <xacro:arg name="ros2_controllers_yaml" default=""/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(arg ros2_controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <!-- Visual materials (Gz Sim uses explicit RGBA, not named Gazebo/ materials) -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.4 0.4 0.4 1</ambient>
      <diffuse>0.5 0.5 0.5 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_1">
    <material>
      <ambient>0.9 0.5 0.0 1</ambient>
      <diffuse>1.0 0.6 0.0 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_2">
    <material>
      <ambient>0.9 0.5 0.0 1</ambient>
      <diffuse>1.0 0.6 0.0 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_3">
    <material>
      <ambient>0.9 0.5 0.0 1</ambient>
      <diffuse>1.0 0.6 0.0 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_4">
    <material>
      <ambient>0.9 0.5 0.0 1</ambient>
      <diffuse>1.0 0.6 0.0 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_5">
    <material>
      <ambient>0.9 0.5 0.0 1</ambient>
      <diffuse>1.0 0.6 0.0 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="link_6">
    <material>
      <ambient>0.4 0.4 0.4 1</ambient>
      <diffuse>0.5 0.5 0.5 1</diffuse>
    </material>
  </gazebo>
  
  <gazebo reference="joint_2">
    <initial_position>0.0</initial_position>
  </gazebo>

</robot>
