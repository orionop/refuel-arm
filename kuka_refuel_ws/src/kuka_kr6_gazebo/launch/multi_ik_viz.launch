<launch>
  <!-- KUKA KR6 R700 — Multi-Solution IK Ghost Arm Visualization -->
  <!-- Ghost RobotModel displays are auto-generated by visualize_ik_solutions.py -->
  <!-- Run the Python script FIRST to generate the config, then launch this. -->

  <!-- Load robot description from xacro -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find kuka_kr6_gazebo)/urdf/kr6_r700.gazebo.xacro" />

  <!-- Base Robot State Publisher (publishes TF from /joint_states) -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <!-- RViz with auto-generated ghost arm config -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find kuka_kr6_gazebo)/config/multi_ik_ghost.rviz" required="true" />
</launch>
