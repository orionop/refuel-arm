<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gz Sim system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Deep Hollow Refueling Inlet (Concave Structure) -->
    <model name="hollow_refuel_inlet">
      <static>true</static>
      <pose>0.62 0.30 0.50 0 0 0</pose>
      <link name="inlet_body">
        <!-- Back Plate (at X=0.72) -->
        <visual name="back_visual">
          <pose>0.10 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.18 0.18</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="back_collision">
          <pose>0.10 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.18 0.18</size></box></geometry>
        </collision>
        <!-- Top Wall -->
        <visual name="top_visual">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.20 0.18 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.20 0.18 0.02</size></box></geometry>
        </collision>
        <!-- Bottom Wall -->
        <visual name="bottom_visual">
          <pose>0 0 -0.08 0 0 0</pose>
          <geometry><box><size>0.20 0.18 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="bottom_collision">
          <pose>0 0 -0.08 0 0 0</pose>
          <geometry><box><size>0.20 0.18 0.02</size></box></geometry>
        </collision>
        <!-- Left Wall -->
        <visual name="left_visual">
          <pose>0 0.08 0 0 0 0</pose>
          <geometry><box><size>0.20 0.02 0.14</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="left_collision">
          <pose>0 0.08 0 0 0 0</pose>
          <geometry><box><size>0.20 0.02 0.14</size></box></geometry>
        </collision>
        <!-- Right Wall -->
        <visual name="right_visual">
          <pose>0 -0.08 0 0 0 0</pose>
          <geometry><box><size>0.20 0.02 0.14</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
          <transparency>0.3</transparency>
        </visual>
        <collision name="right_collision">
          <pose>0 -0.08 0 0 0 0</pose>
          <geometry><box><size>0.20 0.02 0.14</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
