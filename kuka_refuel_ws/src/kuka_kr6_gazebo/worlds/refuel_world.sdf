<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Refined Concave Socket (Industrial Grade) -->
    <model name="hollow_refuel_inlet">
      <static>true</static>
      <!-- Shifted RIGHT to Y=0.40 so the arm spawns further right (away from box) -->
      <pose>0.52 0.40 0.50 0 0 1.5708</pose>
      <link name="inlet_body">
        <!-- Back Face (Goal) -->
        <visual name="back_visual">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.15</size></box></geometry>
        </collision>
        <!-- Surround Walls (20cm Deep) -->
        <visual name="top_wall">
          <pose>0.10 0 0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="top_wall_col">
          <pose>0.10 0 0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_wall">
          <pose>0.10 0 -0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="bottom_wall_col">
          <pose>0.10 0 -0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
        </collision>
        <visual name="left_wall">
          <pose>0.10 0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="left_wall_col">
          <pose>0.10 0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="right_wall">
          <pose>0.10 -0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="right_wall_col">
          <pose>0.10 -0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
        </collision>
        <!-- Flap Removed as requested -->
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- L-Shaped Wall (Static) — partial enclosure around workspace -->
    <!-- Layout (top-down, Y-up, X-right):                          -->
    <!--   .                                                         -->
    <!--   .        kuka (0,0)                                       -->
    <!--   .                                                         -->
    <!--   .  . . . . .              x (inlet)                       -->
    <!--                  c (cylinder, moving)                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Tilted L-Shaped Wall (Static) — unified model with yaw      -->
    <model name="l_wall">
      <static>true</static>
      <!-- Placed corner roughly near (X=0.50, Y=-0.10). Yaw = 0.4 rad (~23 deg) -->
      <pose>0.50 -0.10 0.75 0 0 0.4</pose>
      <link name="wall_links">
        <gravity>false</gravity>

        <!-- Vertical leg (Long): extends backwards (-X) from corner -->
        <visual name="v_vis">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.04 1.50</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="v_col">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.04 1.50</size></box></geometry>
        </collision>

        <!-- Horizontal leg (Short): extends leftwards (+Y) from corner -->
        <visual name="h_vis">
          <pose>0 0.15 0 0 0 0</pose>
          <geometry><box><size>0.04 0.30 1.50</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="h_col">
          <pose>0 0.15 0 0 0 0</pose>
          <geometry><box><size>0.04 0.30 1.50</size></box></geometry>
        </collision>

      </link>
    </model>

    <!-- Moving Cylinder — increased height (1.50m) -->
    <model name="dynamic_pillar">
      <static>true</static>
      <pose>0.60 0.30 0.75 0 0 0</pose>
      <link name="pillar_link">
        <gravity>false</gravity>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1.50</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>1.50</length></cylinder></geometry>
        </collision>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

  </world>
</sdf>
