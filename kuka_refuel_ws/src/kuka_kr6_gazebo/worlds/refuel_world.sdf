<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Refined Concave Socket (Industrial Grade) -->
    <model name="hollow_refuel_inlet">
      <static>true</static>
      <!-- Shifted RIGHT to Y=0.40 so the arm spawns further right (away from box) -->
      <pose>0.52 0.40 0.50 0 0 1.5708</pose>
      <link name="inlet_body">
        <!-- Back Face (Goal) -->
        <visual name="back_visual">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.15 0.15</size></box></geometry>
        </collision>
        <!-- Surround Walls (20cm Deep) -->
        <visual name="top_wall">
          <pose>0.10 0 0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="top_wall_col">
          <pose>0.10 0 0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
        </collision>
        <visual name="bottom_wall">
          <pose>0.10 0 -0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="bottom_wall_col">
          <pose>0.10 0 -0.075 0 0 0</pose>
          <geometry><box><size>0.20 0.15 0.01</size></box></geometry>
        </collision>
        <visual name="left_wall">
          <pose>0.10 0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="left_wall_col">
          <pose>0.10 0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
        </collision>
        <visual name="right_wall">
          <pose>0.10 -0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="right_wall_col">
          <pose>0.10 -0.075 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.15</size></box></geometry>
        </collision>
        <!-- Flap Removed as requested -->
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- L-Shaped Wall (Static) — partial enclosure around workspace -->
    <!-- Layout (top-down, Y-up, X-right):                          -->
    <!--   .                                                         -->
    <!--   .        kuka (0,0)                                       -->
    <!--   .                                                         -->
    <!--   .  . . . . .              x (inlet)                       -->
    <!--                  c (cylinder, moving)                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- L-Wall: Vertical segment — runs along X-axis (forward/back) -->
    <!-- Positioned to the left of the arm (negative Y side)         -->
    <!-- Wall: 0.04m thick, 0.50m long (X), 0.60m tall (Z)          -->
    <model name="l_wall_vertical">
      <static>true</static>
      <pose>0.25 -0.15 0.30 0 0 0</pose>
      <link name="wall_v_link">
        <gravity>false</gravity>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.50 0.04 0.60</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.50 0.04 0.60</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- L-Wall: Horizontal segment — runs along Y-axis (left/right) -->
    <!-- Extends from the front end of the vertical wall toward inlet -->
    <!-- Wall: 0.04m thick, 0.50m wide (Y), 0.60m tall (Z)           -->
    <model name="l_wall_horizontal">
      <static>true</static>
      <pose>0.50 0.15 0.30 0 0 0</pose>
      <link name="wall_h_link">
        <gravity>false</gravity>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.04 0.70 0.60</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.70 0.60</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- REAR L-WALL: Vertical segment (Duplicate shifted backwards X=-0.75) -->
    <model name="l_wall_vertical_rear">
      <static>true</static>
      <pose>-0.50 -0.15 0.30 0 0 0</pose>
      <link name="wall_v_link_rear">
        <gravity>false</gravity>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.50 0.04 0.60</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.50 0.04 0.60</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- REAR L-WALL: Horizontal segment (Duplicate shifted backwards X=-0.75) -->
    <model name="l_wall_horizontal_rear">
      <static>true</static>
      <pose>-0.25 0.15 0.30 0 0 0</pose>
      <link name="wall_h_link_rear">
        <gravity>false</gravity>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.04 0.70 0.60</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.04 0.70 0.60</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Moving Cylinder — taller (0.60m), positioned past the L-wall corner -->
    <model name="dynamic_pillar">
      <static>true</static>
      <pose>0.60 0.30 0.30 0 0 0</pose>
      <link name="pillar_link">
        <gravity>false</gravity>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.60</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.60</length></cylinder></geometry>
        </collision>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

  </world>
</sdf>
