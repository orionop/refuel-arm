<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ════════════════════════════════════════════════════════════ -->
    <!--  FUEL DISPENSER — L-Shaped Wall (STATIC OBSTACLE)          -->
    <!--                                                            -->
    <!--  LIFE-SIZED gas pump structure.                             -->
    <!--  Model center: (0.50, -0.55, 0.0) — far to the RIGHT      -->
    <!--  Leg A (back wall): 0.50m x 0.15m x 0.80m                 -->
    <!--  Leg B (overhang):  0.15m x 0.50m x 0.80m                 -->
    <!--  Nozzle grab point ≈ world (0.50, -0.475, 0.55)           -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <model name="fuel_dispenser">
      <static>true</static>
      <pose>0.50 -0.55 0.0 0 0 0</pose>
      <link name="dispenser_body">

        <!-- Leg A: Main back wall (along X axis) -->
        <visual name="leg_a_vis">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry><box><size>0.50 0.15 0.80</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.65 1</ambient>
            <diffuse>0.15 0.35 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="leg_a_col">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry><box><size>0.50 0.15 0.80</size></box></geometry>
        </collision>

        <!-- Leg B: Overhang extending toward inlet (+Y direction)  -->
        <!-- Flush with the +X outer edge of Leg A                  -->
        <!-- This is the part that BLOCKS the direct sweep path     -->
        <visual name="leg_b_vis">
          <pose>0.175 0.325 0.40 0 0 0</pose>
          <geometry><box><size>0.15 0.50 0.80</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.65 1</ambient>
            <diffuse>0.15 0.35 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="leg_b_col">
          <pose>0.175 0.325 0.40 0 0 0</pose>
          <geometry><box><size>0.15 0.50 0.80</size></box></geometry>
        </collision>

        <!-- Red marker: Nozzle grab point on inner face of Leg A -->
        <visual name="nozzle_marker">
          <pose>0 0.08 0.55 0 0 0</pose>
          <geometry><sphere><radius>0.035</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!--  CAR FUEL INLET — Concave Socket (TARGET)                  -->
    <!--                                                            -->
    <!--  Located far forward-left, well separated from dispenser.  -->
    <!--  Position: (0.55, 0.65, 0.45)                              -->
    <!--  Socket opening: 20cm x 20cm, depth 20cm                   -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <model name="car_fuel_inlet">
      <static>true</static>
      <pose>0.55 0.65 0.45 0 0 1.5708</pose>
      <link name="inlet_body">
        <!-- Back Face (Goal) -->
        <visual name="back_visual">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.20 0.20</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>0.20 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.20 0.20</size></box></geometry>
        </collision>
        <!-- Top wall -->
        <visual name="top_wall">
          <pose>0.10 0 0.10 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="top_wall_col">
          <pose>0.10 0 0.10 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.01</size></box></geometry>
        </collision>
        <!-- Bottom wall -->
        <visual name="bottom_wall">
          <pose>0.10 0 -0.10 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="bottom_wall_col">
          <pose>0.10 0 -0.10 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.01</size></box></geometry>
        </collision>
        <!-- Left wall -->
        <visual name="left_wall">
          <pose>0.10 0.10 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.20</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="left_wall_col">
          <pose>0.10 0.10 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.20</size></box></geometry>
        </collision>
        <!-- Right wall -->
        <visual name="right_wall">
          <pose>0.10 -0.10 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.20</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="right_wall_col">
          <pose>0.10 -0.10 0 0 0 0</pose>
          <geometry><box><size>0.20 0.01 0.20</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!--  DYNAMIC OBSTACLE — Cylinder (Pedestrian / Debris)         -->
    <!--                                                            -->
    <!--  Life-sized obstacle in the open workspace.                -->
    <!--  Position: (0.40, 0.10, 0.30) — between dispenser & inlet -->
    <!--  Radius: 0.10m, Height: 0.60m (person-leg scale)          -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <model name="dynamic_obstacle">
      <static>false</static>
      <pose>0.40 0.10 0.30 0 0 0</pose>
      <link name="cylinder_link">
        <gravity>false</gravity>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.01</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.60</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.25 0.10 1</ambient>
            <diffuse>0.85 0.25 0.10 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.10</radius><length>0.60</length></cylinder></geometry>
        </collision>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

  </world>
</sdf>
