<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_gas_station">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inclusion of the Gas Station (The Island) -->
    <include>
      <uri>model://gas_station</uri>
      <name>gas_station</name>
      <pose>0 0 0 0 0 0</pose> 
    </include>

    <!-- Realistic Car (Prius Hybrid) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_hybrid</name>
      <pose>2.2 -3.0 0.01 0 0 1.5708</pose> <!-- Parked at the pump -->
    </include>

    <!-- Walking Human (The Dynamic Obstacle) -->
    <actor name="walking_human">
      <pose>0 -5.0 0 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/chapulina/models/Walking actor/meshes/walking.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/chapulina/models/Walking actor/meshes/walking.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>0 -5 0 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>4 -5 0 0 0 0</pose></waypoint>
          <waypoint><time>10</time><pose>0 -5 0 0 0 3.14</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Barricade blocking the lane -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FoodCourtBarricade</uri>
      <name>barricade</name>
      <pose>4.5 -3.0 0 0 0 1.57</pose>
    </include>

    <!-- Construction Cone marking the zone -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone</name>
      <pose>1.5 -2.0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
