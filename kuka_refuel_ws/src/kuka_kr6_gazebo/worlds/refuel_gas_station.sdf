<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_gas_station">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gas Station Island -->
    <include>
      <uri>model://gas_station</uri>
      <name>gas_station</name>
      <pose>2.100 -1.450 0 0 0 0</pose> 
    </include>

    <!-- Prius Hybrid (Snapped to Ground) -->
    <include>
      <uri>model://prius_hybrid</uri>
      <name>prius_hybrid</name>
      <pose>1.8371863365173322 -14.317000389099121 -1.3877787807814457e-17 0 0 1.5707999672671702</pose> 
    </include>

    <!-- Static Human -->
    <actor name="walking_human">
      <pose>-1.0937 -13.4 0.01 0 0 0</pose>
      <skin>
        <filename>model://Walking actor/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>model://Walking actor/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
    </actor>

    <!-- Barricade -->
    <include>
      <uri>model://FoodCourtBarricade</uri>
      <name>barricade</name>
      <pose>4.832 -14.509 0.01 0 0 1.57</pose>
    </include>

    <!-- Construction Cone -->
    <include>
      <uri>model://construction_cone</uri>
      <name>cone</name>
      <pose>1.1554228067398074 -12.971693992614744 0 0 0 -0.02600000713487723</pose>
    </include>

    <!-- Elevated KUKA KR 210 Prime Manipulator -->
    <include>
      <uri>model://kr210_prime</uri>
      <name>kuka_kr210</name>
      <pose>-0.05396429821849047 -11.928999900817871 0.29215899109840393 0 0 -1.6273313478183193</pose>
    </include>
  </world>
</sdf>
