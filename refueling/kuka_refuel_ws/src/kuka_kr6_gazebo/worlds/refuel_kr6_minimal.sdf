<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="refuel_kr6_minimal">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- KUKA KR 6 R700 -->
    <include>
      <uri>model://kr6_r700</uri>
      <name>kuka_kr6</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- DOT 1: INLET (CAR) - Within 0.7m reach -->
    <model name="dot_inlet">
      <static>true</static>
      <pose>0.4 0.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DOT 2: DISPENSER - Within 0.7m reach -->
    <model name="dot_dispenser">
      <static>true</static>
      <pose>0.0 0.4 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
