<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="refuel_world">
    <!-- ROS2: gazebo_ros API is loaded automatically by gazebo_ros launch system.
         libgazebo_ros_api_plugin.so does not exist in ROS2 Humble — removed. -->
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

  </world>
</sdf>
